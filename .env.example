# AI backend run through the teacher's logged-in subscription CLI (no API key): claude | codex
AI_BACKEND=claude
# Model alias passed to the CLI (claude: sonnet | opus | haiku)
AI_MODEL=sonnet
# Give up on an AI turn after this many milliseconds
AI_TIMEOUT_MS=180000
# 127.0.0.1 keeps the app private to this computer. Change only for class-mode LAN use.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
MAX_UPLOAD_MB=50

# --- Voice assistant (optional) ---
# Gemini Live is the voice you talk with; it hands every edit to Claude (above, no key) and talks while Claude works.
# Get a key at https://aistudio.google.com/apikey and put it here. It stays on this computer: the browser only
# receives a one-use session token. Leave empty to turn voice off.
GEMINI_API_KEY=
# Optional: pin a Live model (default: the best native-audio Live model your key can use).
GEMINI_LIVE_MODEL=
# Claude model that does the spoken edits: haiku is fast; sonnet is slower but stronger on complex layouts.
GURO_VOICE_MODEL=haiku
