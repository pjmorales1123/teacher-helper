# AI backend run through the teacher's logged-in subscription CLI (no API key): claude | codex
AI_BACKEND=claude
# Model alias passed to the CLI (claude: sonnet | opus | haiku)
AI_MODEL=sonnet
# Give up on an AI turn after this many milliseconds
AI_TIMEOUT_MS=180000
# 127.0.0.1 keeps the app private to this computer. Change only for class-mode LAN use.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
MAX_UPLOAD_MB=50
