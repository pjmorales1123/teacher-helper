# AI backend run through the teacher's logged-in subscription CLI (no API key): claude | codex
AI_BACKEND=claude
# Seconds to wait for the CLI before giving up on a pre-score
AI_TIMEOUT_SECONDS=120
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
# Password the teacher uses to sign in. Change it before exposing the server.
TEACHER_PASSWORD=change-me
